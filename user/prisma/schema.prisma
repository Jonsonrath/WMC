generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(100)
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id])

  @@map("user")
}

model Role {
  id    Int    @id @default(autoincrement())
  title String @db.VarChar(100)
  users User[]

  @@map("role")
}
