{
  "name": "user",
  "version": "1.0.0",
  "description": "User/Role REST-API mit Express und Prisma (MariaDB)",
  "main": "app.ts",
  "type": "module",
  "scripts": {
    "start": "node --watch ./app.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test:api": "sh ./bash/testeverything.sh"
  },
  "author": "Jonathan Rath",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "oxlint": "^1.85.0",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3"
  }
}
